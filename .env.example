# ============================================================
# PressLine — Environment Configuration Template
# ============================================================

# Frontend-Safe Variables (Exposed to the browser bundle)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Only Variables (Used inside Supabase Edge Functions — NEVER expose to browser)
# Set via: supabase secrets set OPENROUTER_API_KEY=...
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional Model Configuration (Server-Side)
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_SITE_URL=https://pressline.ai
OPENROUTER_APP_NAME=PressLine
